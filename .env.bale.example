# Copy to .env.bale on the server and insert the token from Bale's bot manager.
BOT_TOKEN=PUT_YOUR_BALE_TOKEN_HERE
BOT_PLATFORM=bale
BOT_API_ROOT=https://tapi.bale.ai
ADMIN_IDS=1303283683

# Bale documents currently have a 50 MB API ceiling; 49 MiB is a safe margin.
MAX_FILE_SIZE_MB=49
MAX_CONCURRENT_JOBS=2
DOWNLOAD_TIMEOUT_SECONDS=1800
DOWNLOAD_DIR=/data/downloads
DATABASE_PATH=/data/bale.db
# compose.bale.yaml mounts Telegram's data volume here for shared expiring links.
FILE_STORAGE_DIR=/telegram_data/shared_files
YTDLP_MAX_HEIGHT=1080
YTDLP_ALL_SITES=true
AUTO_COMPRESS=true
MAX_PLAYLIST_ITEMS=5

ALLOWED_USER_IDS=
DAILY_DOWNLOAD_LIMIT=10
DAILY_SIZE_LIMIT_MB=1024
ADMIN_PANEL_TOKEN=CHANGE_TO_A_LONG_RANDOM_PASSWORD
FORCE_JOIN_CHANNEL=

# Bale validates its own shared-file tokens. Proxy /bale/ to 127.0.0.1:8081.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=https://dl.sirgsm.ir/bale
FILE_LINK_TTL_SECONDS=3600
LOG_LEVEL=INFO
