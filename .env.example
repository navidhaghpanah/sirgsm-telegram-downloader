# Required: get this from @BotFather. Never publish the real token.
BOT_TOKEN=123456789:PUT_YOUR_REAL_TOKEN_HERE

# Core
MAX_FILE_SIZE_MB=49
MAX_CONCURRENT_JOBS=2
DOWNLOAD_TIMEOUT_SECONDS=1800
DOWNLOAD_DIR=./downloads
DATABASE_PATH=./bot.db
FILE_STORAGE_DIR=./shared_files
YTDLP_MAX_HEIGHT=1080
YTDLP_ALL_SITES=true
AUTO_COMPRESS=true
MAX_PLAYLIST_ITEMS=5

# Public access and daily quota (Tehran time)
ALLOWED_USER_IDS=
DAILY_DOWNLOAD_LIMIT=10
DAILY_SIZE_LIMIT_MB=1024

# Numeric Telegram IDs allowed to use /admin, /block, /broadcast, etc.
ADMIN_IDS=
# Set a long random password for the web panel (Basic Auth user: admin).
ADMIN_PANEL_TOKEN=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# Optional forced channel membership, e.g. @mychannel. Bot must be channel admin.
FORCE_JOIN_CHANNEL=

# Web admin and self-hosted expiring links. Keep disabled until HTTPS is configured.
WEB_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
PUBLIC_BASE_URL=
FILE_LINK_TTL_SECONDS=3600
# Used by compose.web.yaml; DNS A/AAAA record must point to this server.
# PUBLIC_DOMAIN=dl.sirgsm.ir

# Optional yt-dlp access (only content you are authorized to access).
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt
# YTDLP_PROXY=http://user:password@proxy-host:port

# Optional local Telegram Bot API (compose.local-api.yaml)
# TELEGRAM_API_ROOT=http://telegram-bot-api:8081
# API_ID=123456
# API_HASH=your_api_hash

LOG_LEVEL=INFO
